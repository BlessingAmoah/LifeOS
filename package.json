{
  "name": "lifeos",
  "version": "1.0.0",
  "description": "LifeOS - Personal Dashboard",
  "private": true,
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install && cd ../database && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "migrate": "cd database && npm run migrate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlessingAmoah/LifeOS.git"
  },
  "keywords": [
    "personal-dashboard",
    "productivity",
    "life-management",
    "habits",
    "journaling"
  ],
  "author": "BlessingAmoah",
  "license": "MIT"
}
